    "db:generate": "drizzle-kit generate",
    "test": "tsx --test test/*.test.ts",
    "mock:roblox": "tsx scripts/mock-roblox.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.13",
