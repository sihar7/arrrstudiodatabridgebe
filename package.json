{
  "name": "arrr-databridge-api",
  "version": "0.1.0",
  "private": true,
  "description": "ARRR DataBridge API \u2014 auth, workspace, koneksi Roblox Open Cloud, project & konfigurasi DataStore",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
