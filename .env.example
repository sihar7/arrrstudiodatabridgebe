# ARRR DataBridge API
PORT=8080
# URL web (Next.js) — dipakai untuk link & cek Origin
APP_URL=http://localhost:3000
# Postgres (Railway: referensikan ${{Postgres.DATABASE_URL}}). Kosongkan untuk dev lokal → PGlite di ./.data/pglite
DATABASE_URL=
# Kunci enkripsi API key Open Cloud: 32 byte base64. Buat: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Kunci lama saat rotasi (dipisah koma) — tetap bisa mendekripsi, enkripsi baru pakai ENCRYPTION_KEY
ENCRYPTION_KEYS_PREVIOUS=
# Cookie Secure (true di produksi)
COOKIE_SECURE=false
# Roblox OAuth 2.0 app — redirect URL yang didaftarkan: <APP_URL>/api/v1/auth/roblox/callback
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# ROBLOX_OAUTH_CONNECT_SCOPES=openid profile universe-datastores.control:list universe-datastores.objects:list universe-datastores.objects:read universe-datastores.objects:create universe-datastores.objects:update
# Redis Railway (${{Redis.REDIS_URL}}) — antrean migrasi BullMQ. Kosong = runner in-process
REDIS_URL=
RUN_WORKER=true
OC_RPS_PER_UNIVERSE=4
MIGRATION_CONCURRENCY=4
# Admin platform (panel /admin) — hanya email + password (tidak pernah lewat Roblox).
# Akun admin dibuat/diperbarui saat API start; workspace-nya otomatis Enterprise.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Admin tambahan (opsional, dipisah koma; daftar biasa dengan email ini)
ADMIN_EMAILS=
# QRIS statis untuk billing manual
QRIS_IMAGE_URL=/brand/qris.png
QRIS_MERCHANT_NAME=ARRR Studio
